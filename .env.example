# ─────────────────────────────────────────────────────────────────────────────
# Axolotl Plugin Registry — Environment Variables
# Copy this file to .env and fill in the values.
# .env is listed in .gitignore — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub App App ID (found in your GitHub App settings page).
# This is a numeric ID, e.g. 123456.
VITE_GITHUB_APP_ID=PLACEHOLDER_APP_ID

# GitHub App Client ID (also on the settings page, under "Client credentials").
# Format: IvXXXXXXXXXXXXXX
VITE_GITHUB_CLIENT_ID=PLACEHOLDER_CLIENT_ID
